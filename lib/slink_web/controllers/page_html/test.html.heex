<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Slink" suffix=" · Share up links">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", ({ detail: { theme } }) => setTheme(theme));
      })();
    </script>
  </head>

  <body class="flex flex-col min-h-screen bg-base-100">
    <!-- Header: Fixed height, sticky positioning -->
    <header class="flex items-center px-6 py-4 bg-base-200 border-b border-base-300 sticky top-0 z-50 flex-shrink-0 gap-4">
      <div class="flex-1">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
            <span class="text-primary-content font-bold text-sm">S</span>
          </div>
          <span class="font-semibold text-lg">Slink</span>
        </div>
      </div>
      <div class="flex-none">
        <div class="flex items-center gap-2">
          <button class="btn btn-ghost btn-sm">Settings</button>
          <button class="btn btn-primary btn-sm">Profile</button>
        </div>
      </div>
    </header>
    
<!-- Main: Takes remaining space -->
    <main id="main" class="flex flex-1 overflow-hidden relative">
      <!-- Content Area: Scrolls independently, has right margin for sidebar -->
      <section class="flex-1 p-6 pr-[20rem] overflow-y-auto">
        <div class="max-w-4xl mx-auto w-full space-y-6">
          <h1 class="text-3xl font-bold">Dashboard</h1>
          <div class="bg-base-200 rounded-lg p-6">
            <p class="text-base-content/70">Main content area that scrolls independently</p>
            <!-- Demo content showing scrolling behavior -->
            <div class="mt-4 space-y-2">
              <div
                :for={i <- 1..50}
                class="bg-primary/10 rounded p-4 flex items-center justify-between"
              >
                <span class="font-medium">Content Item {i}</span>
                <span class="text-sm text-base-content/50">Sample data</span>
              </div>
            </div>
          </div>
        </div>
      </section>
      
<!-- Sidebar: Fixed positioned, completely independent -->
      <aside class="fixed top-16 right-0 w-80 h-[calc(100vh-4rem)] bg-base-200/50 border-l border-base-300 overflow-y-auto z-40">
        <div class="p-6">
          <h2 class="font-semibold text-lg mb-4 sticky top-0 bg-base-200/50 py-2 -mt-2">
            Quick Actions
          </h2>
          <div class="space-y-3">
            <div class="bg-base-100 rounded-lg p-4">
              <h3 class="font-medium mb-2">Recent Links</h3>
              <p class="text-sm text-base-content/70">Your recent activity</p>
              <div class="mt-2 space-y-1">
                <div class="text-xs text-base-content/50">• Link 1 - 2 hours ago</div>
                <div class="text-xs text-base-content/50">• Link 2 - 5 hours ago</div>
                <div class="text-xs text-base-content/50">• Link 3 - 1 day ago</div>
              </div>
            </div>
            <div class="bg-base-100 rounded-lg p-4">
              <h3 class="font-medium mb-2">Tags</h3>
              <p class="text-sm text-base-content/70">Manage your tags</p>
              <div class="mt-2 flex flex-wrap gap-1">
                <span class="badge badge-primary badge-sm">work</span>
                <span class="badge badge-secondary badge-sm">personal</span>
                <span class="badge badge-accent badge-sm">learning</span>
              </div>
            </div>
            <div class="bg-base-100 rounded-lg p-4">
              <h3 class="font-medium mb-2">Statistics</h3>
              <p class="text-sm text-base-content/70">View analytics</p>
              <div class="mt-2 space-y-1">
                <div class="flex justify-between text-sm">
                  <span>Total Links:</span>
                  <span class="font-medium">127</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span>This Month:</span>
                  <span class="font-medium">23</span>
                </div>
              </div>
            </div>
            <!-- More content to test sidebar scrolling -->
            <div :for={i <- 1..10} class="bg-base-100 rounded-lg p-4">
              <h3 class="font-medium mb-2">Section {i}</h3>
              <p class="text-sm text-base-content/70">
                Additional sidebar content for testing scroll behavior
              </p>
            </div>
          </div>
        </div>
      </aside>
    </main>
  </body>
</html>
